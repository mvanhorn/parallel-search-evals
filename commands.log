### malformed synthetic run: reported and excluded
$ uv run --frozen python -m parallel_search_evals.summarize run_dir=/tmp/pse-demo/malformed-synthetic
suite: hle
search_engine: baseline
model: gpt-fixture
provider: openai
source_sha256: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
records found: 2
completed: 2
failed: 0
correct: 1
score: 0.75
failure kinds: none
malformed task files (excluded from score; would rerun on resume):
  task-c.json
saved summary: agrees
exit: 0

### sentinel must not appear in CSV
$ rg SYNTHETIC_SENTINEL_DO_NOT_EXPORT /tmp/pse-demo/clean-synthetic.csv
exit: 1

### sentinel must not appear in clean summarize stdout
$ rg SYNTHETIC_SENTINEL_DO_NOT_EXPORT /tmp/pse-demo/clean-stdout.txt
exit: 1

### sentinel must not appear in malformed summarize stdout
$ rg SYNTHETIC_SENTINEL_DO_NOT_EXPORT /tmp/pse-demo/malformed-stdout.txt
exit: 1

### sentinel is present in the private synthetic task files
$ rg -l SYNTHETIC_SENTINEL_DO_NOT_EXPORT /tmp/pse-demo/clean-synthetic
/tmp/pse-demo/clean-synthetic/task-c.json
/tmp/pse-demo/clean-synthetic/task-a.json
/tmp/pse-demo/clean-synthetic/task-b.json
exit: 0

